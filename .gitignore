# =============================================
# 小智服务端 (xiaozhi-server) .gitignore
# =============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/
# 虚拟环境
.venv/
venv/
env/
ENV/
# 测试 / 静态检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 模型大文件（不要进仓库）----------
# 语音识别 / VAD 等模型权重，体积大，本地按需下载
*.pt
*.pth
*.bin
*.gguf
*.safetensors
*.ckpt
# onnx：silero-vad 自带的已跟踪文件不受影响，此处仅拦截新增模型
*.onnx
# SenseVoice 大模型目录（约 894M）
models/SenseVoiceSmall/model.*
models/SenseVoiceSmall/*.pt
models/SenseVoiceSmall/*.onnx

# ---------- 运行时输出 / 临时文件 ----------
# tmp/ 下是 server.log 和生成的 TTS 音频
tmp/
*.log
logs/
# 根目录的测试音频（config/assets 下的素材保留）
/test.wav
/test_*.wav

# ---------- 本地配置（可能含密钥）----------
# data/ 下的点文件是运行时生成的本地配置
data/.config.yaml
data/.wakeup_words.yaml
data/bin/
# 环境变量
.env
.env.*
*.env
!.env.example
# config.yaml 含真实 API Key，建议改用 config.yaml.example 模板并取消跟踪
# 迁移步骤：cp config.yaml config.yaml.example（把密钥改成占位符）→ git rm --cached config.yaml
config.yaml

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

CODE_REVIEW.md
config/agent.env
